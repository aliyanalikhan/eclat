# Éclat environment variables. Copy to .env.local and fill in real values —
# never commit real values. Names only, documented per milestone phase.

# Phase 1 — Vercel Postgres. Auto-injected via `vercel env pull .env.local`
# once provisioned (D-12). Use POSTGRES_URL (pooled) in serverless code —
# never POSTGRES_URL_NON_POOLING (D-03).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Phase 2 — Google OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Phase 3 — Stripe billing & webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
